# ---------------------------------------------------------------------------
# OpenSky Network credentials (OPTIONAL — the app works without them)
# ---------------------------------------------------------------------------
# OpenSky deprecated Basic-auth / heavy anonymous use in 2025 in favor of
# OAuth2 client credentials. Without credentials, sky-tracker still tries
# OpenSky's anonymous API (400 request-credits/day, shared per IP) and
# degrades gracefully to satellites-only when that is rate-limited or blocked.
# With credentials you get 4000 credits/day and a stable feed.
#
# How to create credentials (free):
#   1. Register an account at https://opensky-network.org
#   2. Log in, open your Account page: https://opensky-network.org/my-opensky
#   3. Create an "API client" — this shows a client_id and client_secret
#   4. Paste them below (local: copy this file to .env.local), or in Vercel:
#      Project → Settings → Environment Variables → add both → redeploy
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Set to "0" to forbid anonymous OpenSky access entirely (planes disabled
# unless credentials are configured). Default is anonymous fallback ON.
OPENSKY_ANONYMOUS=1
